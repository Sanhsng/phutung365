# Supabase Configuration
# 1. Lấy từ Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Sử dụng "Publishable key" (tương ứng với anon key cho client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# 3. Secret Key (Service Role key) - Dành riêng cho Server Backend gọi API / MISA Webhook
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here
